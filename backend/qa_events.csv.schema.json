{
  "$id": "https://example.invalid/o009/backend/qa_events.csv.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^artifact\\.[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "event_id": {
      "pattern": "^qa\\.[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "structural-translation",
        "build-binding",
        "input-binding",
        "rights-binding",
        "prerequisite-boundary",
        "graph-validation"
      ],
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "recorded"
      ],
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "artifact_id",
    "result",
    "detail",
    "timestamp",
    "status"
  ],
  "title": "Strict row schema for qa_events.csv",
  "type": "object",
  "x-csv": {
    "encoding": "utf-8",
    "header": [
      "event_id",
      "event_type",
      "artifact_id",
      "result",
      "detail",
      "timestamp",
      "status"
    ],
    "line_ending": "CRLF"
  }
}
